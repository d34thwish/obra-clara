# Public GitHub Actions variables
CLOUDFLARE_ACCOUNT_ID=replace-with-32-character-account-id
CLOUDFLARE_D1_DATABASE_ID=replace-with-production-d1-uuid
CLOUDFLARE_R2_BUCKET_NAME=replace-with-production-r2-bucket
PUBLIC_BASE_URL=https://replace-with-production-origin
TURNSTILE_SITE_KEY=replace-with-public-site-key
TURNSTILE_HOSTNAME=replace-with-production-hostname
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
MODERATOR_EMAILS=
CORS_ALLOWED_ORIGINS=

# GitHub Actions secrets. Never commit actual values.
CLOUDFLARE_API_TOKEN=store-in-github-production-environment-secret
TURNSTILE_SECRET_KEY=store-in-github-production-environment-secret

# Fixed by the deployment workflow
DEMO_MODE=false
ENVIRONMENT=production
TURNSTILE_ACTION=community_submission
